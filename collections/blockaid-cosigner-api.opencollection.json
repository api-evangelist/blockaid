        {
          "info": {
            "name": "Evaluate EVM Transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.blockaid.io/v0/platform/cosigners/:id/evm/evaluate",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Cosigner ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Run policy evaluation against an EVM transaction for the given cosigner. Returns the policy decision and per-policy trace."
        }
      ]
    }
  ],
  "bundled": true
}