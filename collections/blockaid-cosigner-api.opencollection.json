              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Update a cosigner by ID; the fields you send replace the existing ones."
        },
        {
          "info": {
            "name": "Delete Cosigner External Route",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.blockaid.io/v0/platform/cosigners/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
