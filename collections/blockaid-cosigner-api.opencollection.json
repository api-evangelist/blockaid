              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Fetch a cosigner by name."
        },
        {
          "info": {
            "name": "Get Cosigner External Route",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blockaid.io/v0/platform/cosigners/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
