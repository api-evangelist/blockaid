{
  "opencollection": "1.0.0",
  "info": {
    "name": "Blockaid Asset Management Audit Logs API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Audit Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Audit Logs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.blockaid.io/v0/platform/audit-logs/search",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns audit events for the organization. Dates are interpreted in UTC. Request/response enums are aligned so values returned can be reused as filters."
        }
      ]
    }
  ],
  "bundled": true
}