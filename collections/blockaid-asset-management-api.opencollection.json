            "method": "DELETE",
            "url": "https://api.blockaid.io/v0/platform/assets/:identifier",
            "params": [
              {
                "name": "identifier",
                "value": "0xFf7d6A96ae471BbCD7713aF9CB1fEeB16cf56B41",
                "type": "path",
                "description": "The contract address or domain that identifies this asset."
