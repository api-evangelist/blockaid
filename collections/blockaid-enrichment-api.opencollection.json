            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Logs an account login event."
        },
        {
          "info": {
            "name": "Modify Account",
            "type": "http"
          },
          "http": {
