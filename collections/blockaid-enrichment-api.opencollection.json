            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Modifies an account."
        },
        {
          "info": {
            "name": "Report Fraud",
            "type": "http"
          },
          "http": {
            "method": "POST",
